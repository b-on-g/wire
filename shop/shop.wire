object $bog_wire_shop {

	solid catalog() {
		return $bog_wire_shop_catalog()
	}

	solid cart() {
		return $bog_wire_shop_cart()
	}

	line( sku: text ) {
		return $bog_wire_shop_line()
	}

	line_sum( line: $bog_wire_shop_line ) {
		return line.sum
	}

	line_label( line: $bog_wire_shop_line ) {
		return line.label
	}

	lines() {
		return cart.skus.map( line )
	}

	total() {
		return lines.map( line_sum ).sum
	}

	receipt() {
		return [ ... lines.map( line_label ), "total {total}" ]
	}

	action add( sku: text ) {
		cart.set( sku, cart.qty( sku ) + 1 )
	}

	action remove( sku: text ) {
		cart.set( sku, 0 )
	}

}
