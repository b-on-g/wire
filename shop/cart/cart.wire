type $bog_wire_shop_cart_item {
	sku: text
	qty: int
}

object $bog_wire_shop_cart {

	solid items( next?: list $bog_wire_shop_cart_item ) {
		return next ?? []
	}

	sku_of( item: $bog_wire_shop_cart_item ) {
		return item.sku
	}

	skus() {
		return items.map( sku_of )
	}

	item( sku: text ) {
		return items.find( sku_of, sku )
	}

	qty( sku: text ) {
		return item( sku )?.qty ?? 0
	}

	action set( sku: text, count: int ) {
		items( count > 0
			? items.upsert( sku_of, sku, $bog_wire_shop_cart_item{ sku, qty: count } )
			: items.drop( sku_of, sku )
		)
	}

}
