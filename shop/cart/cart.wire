type $bog_wire_shop_cart_item {
	sku: text
	qty: int
}

object $bog_wire_shop_cart {

	solid items( next?: list $bog_wire_shop_cart_item ) = next ?? []

	sku_of( item: $bog_wire_shop_cart_item ) = item.sku

	skus = items.map( sku_of )

	item( sku: text ) = items.find( sku_of, sku )

	qty( sku: text ) = item( sku )?.qty ?? 0

	action set( sku: text, count: int ) {
		items( count > 0
			? items.upsert( sku_of, sku, $bog_wire_shop_cart_item{ sku, qty: count } )
			: items.drop( sku_of, sku )
		)
	}

}
