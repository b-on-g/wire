object $bog_wire_salt {

	solid ids( next?: list text ) {
		return next ?? []
	}

	solid qty( id: text, next?: int ) {
		return next ?? 0
	}

	total(): int {
		return 10
	}

	ordered(): int {
		return ids.map( qty ).sum
	}

	free(): int {
		return total - ordered
	}

	action order( id: text, count: int ) {
		ids( [ ...ids, id ] )
		qty( id, count )
	}

	action cancel( id: text ) {
		qty( id, 0 )
	}

}
