object $bog_wire_salt_test {

	salt() {
		return $bog_wire_salt()
	}

	action free_is_total_minus_orders() {
		salt.orders.add( "o1", 3 )
		salt.orders.add( "o2", 2 )
		assert( salt.balance.free == 5 )
	}

	action rewrite_order_recalculates_free() {
		salt.orders.add( "o1", 3 )
		salt.orders.order( "o1", 5 )
		assert( salt.balance.free == 5 )
	}

	action cancel_returns_salt() {
		salt.orders.add( "o1", 3 )
		salt.orders.order( "o1", 0 )
		assert( salt.balance.free == 10 )
	}

	action unknown_order_reads_zero() {
		assert( salt.orders.order( "o9" ) == 0 )
	}

}
