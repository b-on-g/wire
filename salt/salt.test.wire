object $bog_wire_salt_test {

	salt() {
		return $bog_wire_salt()
	}

	action free_is_total_minus_orders() {
		salt.order( "o1", 3 )
		salt.order( "o2", 2 )
		assert( salt.free == 5 )
	}

	action cancel_returns_salt() {
		salt.order( "o1", 3 )
		salt.cancel( "o1" )
		assert( salt.free == 10 )
	}

}
