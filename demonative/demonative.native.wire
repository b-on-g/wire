object $bog_wire_demonative_repl {

	solid app() {
		return $bog_wire_demonative()
	}

	solid seen( next?: int ) {
		return next ?? 0
	}

	line() {
		return stdin( seen )
	}

	said() {
		return line ?? ""
	}

	action main() {
		step()
	}

	action step() {
		line == none ? none : handle()
	}

	action handle() {
		app.exec( said )
		app.command( said ).skipped || app.command( said ).error != "" ? none : show()
		seen( seen + 1 )
		after( step )
	}

	action show() {
		print( app.sheet.table )
		print( "--" )
	}

}
