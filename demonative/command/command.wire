object $bog_wire_demonative_command {

	source: text

	input() {
		return source.trim
	}

	eq() {
		return input.find( "=" ) ?? -1
	}

	name() {
		return input.slice( 0, eq ).trim
	}

	formula() {
		return input.slice( eq + 1, input.size ).trim
	}

	char( pos: int ) {
		return name.slice( pos, pos + 1 )
	}

	upper( pos: int ) {
		return char( pos ) >= "A" && char( pos ) <= "Z"
	}

	digit( pos: int ) {
		return char( pos ) >= "0" && char( pos ) <= "9"
	}

	name_from( pos: int ): bool {
		return pos >= name.size || ( upper( pos ) || pos > 0 && digit( pos ) ) && name_from( pos + 1 )
	}

	skipped() {
		return input == "" || input.slice( 0, 1 ) == "#"
	}

	error() {
		return skipped ? ""
			: eq < 0 ? "expected NAME = formula"
			: name == "" || !name_from( 0 ) ? "bad name: {name}"
			: ""
	}

}
