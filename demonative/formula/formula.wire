type $bog_wire_demonative_formula_step {
	num: float
	err: text
	end: int
}

object $bog_wire_demonative_formula {

	source: text
	sheet: $bog_wire_demonative_sheet

	size() {
		return source.size
	}

	char( pos: int ) {
		return source.slice( pos, pos + 1 )
	}

	digit( c: text ) {
		return c >= "0" && c <= "9"
	}

	upper( c: text ) {
		return c >= "A" && c <= "Z"
	}

	skip( pos: int ): int {
		return char( pos ) == " " ? skip( pos + 1 ) : pos
	}

	sign( pos: int ) {
		return char( skip( pos ) )
	}

	fail( pos: int ) {
		return $bog_wire_demonative_formula_step{ num: 0.0, err: "syntax", end: pos }
	}

	result() {
		return source.trim == ""
			? $bog_wire_demonative_formula_step{ num: 0.0, err: "", end: 0 }
			: whole( expr( 0 ) )
	}

	whole( step: $bog_wire_demonative_formula_step ): $bog_wire_demonative_formula_step {
		return step.err != ""
			? step
			: skip( step.end ) == size ? step : fail( step.end )
	}

	expr( pos: int ) {
		return expr_tail( term( pos ) )
	}

	expr_tail( left: $bog_wire_demonative_formula_step ): $bog_wire_demonative_formula_step {
		return left.err != ""
			? left
			: sign( left.end ) == "+" ? expr_tail( plus( left, term( skip( left.end ) + 1 ) ) )
			: sign( left.end ) == "-" ? expr_tail( minus( left, term( skip( left.end ) + 1 ) ) )
			: left
	}

	term( pos: int ) {
		return term_tail( factor( pos ) )
	}

	term_tail( left: $bog_wire_demonative_formula_step ): $bog_wire_demonative_formula_step {
		return left.err != ""
			? left
			: sign( left.end ) == "*" ? term_tail( times( left, factor( skip( left.end ) + 1 ) ) )
			: sign( left.end ) == "/" ? term_tail( divide( left, factor( skip( left.end ) + 1 ) ) )
			: left
	}

	plus( a: $bog_wire_demonative_formula_step, b: $bog_wire_demonative_formula_step ) {
		return b.err != ""
			? b
			: $bog_wire_demonative_formula_step{ num: a.num + b.num, err: "", end: b.end }
	}

	minus( a: $bog_wire_demonative_formula_step, b: $bog_wire_demonative_formula_step ) {
		return b.err != ""
			? b
			: $bog_wire_demonative_formula_step{ num: a.num - b.num, err: "", end: b.end }
	}

	times( a: $bog_wire_demonative_formula_step, b: $bog_wire_demonative_formula_step ) {
		return b.err != ""
			? b
			: $bog_wire_demonative_formula_step{ num: a.num * b.num, err: "", end: b.end }
	}

	divide( a: $bog_wire_demonative_formula_step, b: $bog_wire_demonative_formula_step ) {
		return b.err != ""
			? b
			: b.num == 0.0 ? $bog_wire_demonative_formula_step{ num: 0.0, err: "div0", end: b.end }
			: $bog_wire_demonative_formula_step{ num: a.num / b.num, err: "", end: b.end }
	}

	factor( at: int ): $bog_wire_demonative_formula_step {
		return factor_at( skip( at ) )
	}

	factor_at( pos: int ): $bog_wire_demonative_formula_step {
		return char( pos ) == "-" ? negate( factor( pos + 1 ) )
			: char( pos ) == "(" ? closing( expr( pos + 1 ) )
			: digit( char( pos ) ) ? number( pos, digit_end( pos ) )
			: upper( char( pos ) ) ? reference( pos, name_end( pos ) )
			: fail( pos )
	}

	negate( step: $bog_wire_demonative_formula_step ) {
		return $bog_wire_demonative_formula_step{ num: 0.0 - step.num, err: step.err, end: step.end }
	}

	closing( step: $bog_wire_demonative_formula_step ) {
		return step.err != ""
			? step
			: sign( step.end ) == ")" ? $bog_wire_demonative_formula_step{ num: step.num, err: "", end: skip( step.end ) + 1 }
			: fail( step.end )
	}

	digit_end( pos: int ): int {
		return digit( char( pos ) ) || char( pos ) == "." ? digit_end( pos + 1 ) : pos
	}

	number( from: int, to: int ) {
		return numbered( source.slice( from, to ).float, to )
	}

	numbered( value: float?, end: int ) {
		return value == none
			? fail( end )
			: $bog_wire_demonative_formula_step{ num: value ?? 0.0, err: "", end }
	}

	name_end( pos: int ): int {
		return upper( char( pos ) ) || digit( char( pos ) ) ? name_end( pos + 1 ) : pos
	}

	reference( from: int, to: int ) {
		return looked( sheet.value( source.slice( from, to ) ), to )
	}

	looked( found: $bog_wire_demonative_sheet_result, end: int ) {
		return $bog_wire_demonative_formula_step{ num: found.num, err: found.err, end }
	}

	starts( pos: int ) {
		return upper( char( pos ) ) && ( pos == 0 || !upper( char( pos - 1 ) ) && !digit( char( pos - 1 ) ) )
	}

	names_from( pos: int ): list text {
		return pos >= size
			? []
			: starts( pos ) ? [ source.slice( pos, name_end( pos ) ), ... names_from( name_end( pos ) ) ]
			: names_from( pos + 1 )
	}

	refs() {
		return names_from( 0 )
	}

}
