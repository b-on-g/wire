type $bog_wire_demonative_sheet_cell {
	name: text
	source: text
}

type $bog_wire_demonative_sheet_result {
	num: float
	err: text
}

object $bog_wire_demonative_sheet {

	solid cells( next?: list $bog_wire_demonative_sheet_cell ) {
		return next ?? []
	}

	cell_name( cell: $bog_wire_demonative_sheet_cell ) {
		return cell.name
	}

	same( name: text ) {
		return name
	}

	names() {
		return cells.map( cell_name ).sort( same )
	}

	source( name: text ) {
		return cells.find( cell_name, name )?.source ?? ""
	}

	formula( name: text ) {
		return $bog_wire_demonative_formula {
			source <= source( name )
			sheet <= self
		}
	}

	refs( name: text ) {
		return formula( name ).refs
	}

	search( target: text, depth: int ) {
		return $bog_wire_demonative_sheet_search {
			target <= target
			depth <= depth
			sheet <= self
		}
	}

	cyclic( name: text ) {
		return search( name, names.size ).any( name )
	}

	value( name: text ): $bog_wire_demonative_sheet_result {
		return cyclic( name )
			? $bog_wire_demonative_sheet_result{ num: 0.0, err: "cycle" }
			: computed( formula( name ).result )
	}

	computed( step: $bog_wire_demonative_formula_step ) {
		return $bog_wire_demonative_sheet_result{ num: step.num, err: step.err }
	}

	row( name: text ) {
		return value( name ).err == ""
			? "{name} = {value( name ).num}"
			: "{name} = #{value( name ).err}"
	}

	table() {
		return names.map( row ).join( "\n" )
	}

	action set( name: text, formula_text: text ) {
		cells( formula_text == ""
			? cells.drop( cell_name, name )
			: cells.upsert( cell_name, name, $bog_wire_demonative_sheet_cell{ name, source: formula_text } )
		)
	}

}

object $bog_wire_demonative_sheet_search {

	target: text
	depth: int
	sheet: $bog_wire_demonative_sheet

	yes( flag: bool ) {
		return flag
	}

	hop( name: text ): bool {
		return name == target || depth > 0 && sheet.search( target, depth - 1 ).any( name )
	}

	any( from: text ): bool {
		return sheet.refs( from ).map( hop ).find( yes, true ) != none
	}

}
